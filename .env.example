ATHENA_ENV=development
ATHENA_DATABASE_URL=postgresql+psycopg://athena:athena@localhost:5432/athena
ATHENA_KEYCLOAK_URL=http://localhost:8080
ATHENA_KEYCLOAK_REALM=athena
ATHENA_KEYCLOAK_CLIENT_ID=athena-collector
ATHENA_KEYCLOAK_CLIENT_SECRET=athena-local-collector-secret
ATHENA_OPA_URL=http://localhost:8181
ATHENA_NEO4J_ENABLED=false
ATHENA_NEO4J_URL=neo4j://localhost:7687
ATHENA_NEO4J_USER=neo4j
ATHENA_NEO4J_PASSWORD=
ATHENA_NEO4J_DATABASE=neo4j
ATHENA_AUTH_REQUIRED=true
ATHENA_OIDC_ISSUER=http://localhost:8080/realms/athena
ATHENA_OIDC_AUDIENCE=athena-api
ATHENA_OIDC_JWKS_URL=
ATHENA_OLLAMA_URL=http://localhost:11434
ATHENA_OLLAMA_MODEL=gemma3:4b
ATHENA_OLLAMA_TIMEOUT_SECONDS=60
ATHENA_GITHUB_ORG=
ATHENA_GITHUB_TOKEN=
ATHENA_GITHUB_API_URL=https://api.github.com
ATHENA_GITHUB_API_VERSION=2026-03-10
ATHENA_AZURE_ENABLED=false
ATHENA_AZURE_TENANT_ID=
ATHENA_AZURE_SUBSCRIPTION_ID=
