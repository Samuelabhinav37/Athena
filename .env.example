ATHENA_AZURE_MANAGEMENT_URL=https://management.azure.com

POSTGRES_DB=athena
POSTGRES_USER=athena
POSTGRES_PASSWORD=athena

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
NEO4J_AUTH=neo4j/change-me
